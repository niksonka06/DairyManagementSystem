@{
    ViewData["Title"] = "Home";
    Layout = "_AuthLayout";
}

<div class="landing-panel">
    <div class="landing-card-wide">
        <img src="~/images/logo_main.png" alt="Smart Dairy Cooperative Management System" class="brand-logo-lockup" />
        <p class="landing-lead">
            Eliminate paper registers and manual settlement errors. Manage collection, deductions,
            weekly payments, dispatch, and farmer transparency from one secure web application.
        </p>

        <div class="landing-features">
            <div class="landing-feature">
                <i class="bi bi-graph-up-arrow"></i>
                <strong>Fat-based</strong>
                <span>auto rates</span>
            </div>
            <div class="landing-feature">
                <i class="bi bi-clock-history"></i>
                <strong>2 shifts</strong>
                <span>daily entry</span>
            </div>
            <div class="landing-feature">
                <i class="bi bi-calendar-week"></i>
                <strong>Weekly</strong>
                <span>settlements</span>
            </div>
        </div>

        <a asp-area="" asp-controller="Account" asp-action="Login" class="btn btn-primary btn-lg px-5">Login to the system</a>
    </div>
</div>
