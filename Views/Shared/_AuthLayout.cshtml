<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Smart Dairy</title>
    <link rel="icon" type="image/png" href="~/images/logo_icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,600;12..96,700&family=Manrope:wght@400;500;600&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="auth-body">
    <div class="auth-shell">
        <section class="auth-hero">
            <div class="auth-hero-brand">
                <img src="~/images/logo_icon.png" alt="Smart Dairy" class="brand-logo-img brand-logo-img-lg" />
                <div>
                    <div class="auth-brand-title">Smart Dairy</div>
                    <div class="auth-brand-sub">Cooperative Management System</div>
                </div>
            </div>

            <h1>Every litre counted. Every farmer paid fairly.</h1>
            <p>
                Shift-wise milk collection, fat-based rates, cattle-feed deductions, weekly settlements and union dispatch — on one transparent platform.
            </p>
        </section>

        <section class="auth-panel">
            @RenderBody()
        </section>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
