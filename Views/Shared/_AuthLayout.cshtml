<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Smart Dairy Cooperative</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="auth-body">
    <div class="auth-shell">
        <section class="auth-hero">
            <div class="auth-hero-brand">
                <div class="auth-logo"><i class="bi bi-droplet-half"></i></div>
                <span>Smart Dairy Cooperative</span>
            </div>
            <h1>Every litre counted.<br />Every farmer paid fairly.</h1>
            <p>Shift-wise milk collection, fat-based rate charts, cattle-feed deductions, weekly settlements and union dispatch — on one transparent platform.</p>
            <div class="auth-hero-stats">
                <div><strong>Fat-based</strong><span>auto rates</span></div>
                <div><strong>2 shifts</strong><span>daily entry</span></div>
                <div><strong>Weekly</strong><span>settlements</span></div>
            </div>
            <p class="auth-hero-foot">Built for village dairy societies and their member farmers.</p>
        </section>

        <section class="auth-panel">
            @RenderBody()
        </section>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
