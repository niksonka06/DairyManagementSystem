@model DailyReconciliationReportViewModel
@{
    ViewData["Title"] = "Daily Dispatch Reconciliation";
    int? societyId = ViewBag.SocietyId;
}

<h2 class="mb-4">Daily Dispatch Reconciliation</h2>
<p class="text-muted">Accepted milk collected versus milk dispatched to the union, with variance reason when recorded.</p>

<form method="get" class="row g-2 mb-4 align-items-end">
    <input type="hidden" name="societyId" value="@societyId" />
    <div class="col-auto">
        <label class="form-label">From</label>
        <input type="date" name="from" value="@Model.FromDate.ToString("yyyy-MM-dd")" class="form-control" />
    </div>
    <div class="col-auto">
        <label class="form-label">To</label>
        <input type="date" name="to" value="@Model.ToDate.ToString("yyyy-MM-dd")" class="form-control" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">View</button>
        <a href="@Url.Action("DailyReconciliationPdf", new { societyId, from = Model.FromDate.ToString("yyyy-MM-dd"), to = Model.ToDate.ToString("yyyy-MM-dd") })" class="btn btn-outline-secondary">Download PDF</a>
    </div>
</form>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Date</th>
            <th>Collected</th>
            <th>Dispatched</th>
            <th>Variance</th>
            <th>Reason</th>
            <th>Vehicle</th>
            <th>Destination</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var r in Model.Rows)
        {
            <tr>
                <td>@r.Date.ToString("dd-MMM-yyyy")</td>
                <td>@r.TotalCollected.ToString("0.00") L</td>
                <td>@(r.HasDispatch ? $"{r.TotalDispatched:0.00} L" : "—")</td>
                <td>
                    @if (r.HasDispatch)
                    {
                        @($"{r.Variance:0.00} L ({r.VariancePercent:0.0}%)")
                    }
                    else
                    {
                        <span class="text-muted">No dispatch</span>
                    }
                </td>
                <td>@(string.IsNullOrWhiteSpace(r.VarianceReason) ? "—" : r.VarianceReason)</td>
                <td>@(r.VehicleNo ?? "—")</td>
                <td>@(r.Destination ?? "—")</td>
            </tr>
        }
        @if (!Model.Rows.Any())
        {
            <tr><td colspan="7" class="text-center text-muted">No collection or dispatch in this period.</td></tr>
        }
    </tbody>
</table>

<a asp-action="Index" asp-route-societyId="@societyId" class="btn btn-outline-secondary">Back to Reports</a>
