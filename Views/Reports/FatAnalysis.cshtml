@model FatAnalysisReportViewModel
@{
    ViewData["Title"] = "Fat Analysis Report";
    int? societyId = ViewBag.SocietyId;
}

<h2 class="mb-4">Fat Analysis Report</h2>

<form method="get" class="row g-2 mb-4 align-items-end">
    <input type="hidden" name="societyId" value="@societyId" />
    <div class="col-auto">
        <label class="form-label">From</label>
        <input type="date" name="from" value="@Model.FromDate.ToString("yyyy-MM-dd")" class="form-control" />
    </div>
    <div class="col-auto">
        <label class="form-label">To</label>
        <input type="date" name="to" value="@Model.ToDate.ToString("yyyy-MM-dd")" class="form-control" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">View</button>
        <a href="@Url.Action("FatAnalysisPdf", new { societyId, from = Model.FromDate.ToString("yyyy-MM-dd"), to = Model.ToDate.ToString("yyyy-MM-dd") })" class="btn btn-outline-secondary">Download PDF</a>
    </div>
</form>

<div class="row">
    <div class="col-md-6 mb-4">
        <h5>Fat Distribution</h5>
        <canvas id="distributionChart" height="200"></canvas>
    </div>
    <div class="col-md-6 mb-4">
        <h5>Average Fat Trend</h5>
        <canvas id="trendChart" height="200"></canvas>
    </div>
</div>

<h5>Farmer-wise Average Fat %</h5>
<table class="table table-striped table-hover">
    <thead><tr><th>Farmer</th><th>Average Fat %</th><th>Collections</th></tr></thead>
    <tbody>
        @foreach (var r in Model.FarmerAverages)
        {
            <tr>
                <td>@r.FarmerCode — @r.FarmerName</td>
                <td>@r.AverageFat.ToString("0.00")%</td>
                <td>@r.CollectionCount</td>
            </tr>
        }
        @if (!Model.FarmerAverages.Any())
        {
            <tr><td colspan="3" class="text-center text-muted">No collections in this period.</td></tr>
        }
    </tbody>
</table>

<a asp-action="Index" asp-route-societyId="@societyId" class="btn btn-outline-secondary">Back to Reports</a>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <script>
        const distLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Distribution.Select(d => d.Label)));
        const distCounts = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Distribution.Select(d => d.Count)));

        new Chart(document.getElementById('distributionChart'), {
            type: 'bar',
            data: { labels: distLabels, datasets: [{ label: 'Collections', data: distCounts, backgroundColor: '#0d6efd' }] },
            options: { plugins: { legend: { display: false } } }
        });

        const trendLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Trend.Select(t => t.Date.ToString("dd-MMM"))));
        const trendValues = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Trend.Select(t => t.AverageFat)));

        new Chart(document.getElementById('trendChart'), {
            type: 'line',
            data: { labels: trendLabels, datasets: [{ label: 'Avg Fat %', data: trendValues, borderColor: '#198754', tension: 0.2 }] },
            options: { plugins: { legend: { display: false } } }
        });
    </script>
}
