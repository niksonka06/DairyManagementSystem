@model FarmerSettlementReportViewModel
@{
    ViewData["Title"] = "Farmer Settlement Report";
    int? societyId = ViewBag.SocietyId;
}

<h2 class="mb-4">Farmer Settlement Report</h2>

<form method="get" class="row g-2 mb-4 align-items-end">
    <input type="hidden" name="societyId" value="@societyId" />
    <div class="col-auto">
        <label class="form-label">From</label>
        <input type="date" name="from" value="@Model.FromDate.ToString("yyyy-MM-dd")" class="form-control" />
    </div>
    <div class="col-auto">
        <label class="form-label">To</label>
        <input type="date" name="to" value="@Model.ToDate.ToString("yyyy-MM-dd")" class="form-control" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">View</button>
        <a href="@Url.Action("FarmerSettlementPdf", new { societyId, from = Model.FromDate.ToString("yyyy-MM-dd"), to = Model.ToDate.ToString("yyyy-MM-dd") })" class="btn btn-outline-secondary">Download PDF</a>
    </div>
</form>

<div class="table-responsive">
<table class="table table-striped table-hover">
    <thead>
        <tr><th>Farmer</th><th>Period</th><th>Gross</th><th>Feed</th><th>Medicine</th><th>Other</th><th>Prev Due</th><th>Advance</th><th>Net</th><th>Status</th></tr>
    </thead>
    <tbody>
        @foreach (var r in Model.Rows)
        {
            <tr>
                <td>@r.FarmerCode — @r.FarmerName</td>
                <td>@r.PeriodStart.ToString("dd-MMM") - @r.PeriodEnd.ToString("dd-MMM")</td>
                <td>₹@r.GrossAmount.ToString("0.00")</td>
                <td>₹@r.FeedDeduction.ToString("0.00")</td>
                <td>₹@r.MedicineDeduction.ToString("0.00")</td>
                <td>₹@r.OtherDeductionsTotal.ToString("0.00")</td>
                <td>₹@r.PreviousDue.ToString("0.00")</td>
                <td>₹@r.AdvancePaid.ToString("0.00")</td>
                <td><strong>₹@r.NetAmount.ToString("0.00")</strong></td>
                <td>@r.Status</td>
            </tr>
        }
        @if (!Model.Rows.Any())
        {
            <tr><td colspan="10" class="text-center text-muted">No settlements in this period.</td></tr>
        }
    </tbody>
</table>
</div>

<p><strong>Total Net Amount (excl. Cancelled): ₹@Model.TotalNetAmount.ToString("0.00")</strong></p>

<a asp-action="Index" asp-route-societyId="@societyId" class="btn btn-outline-secondary">Back to Reports</a>
