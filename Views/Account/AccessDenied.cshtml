@{
    ViewData["Title"] = "Access Denied";
    Layout = "_AuthLayout";
}

<div class="auth-card">
    <h2 class="text-danger">Access Denied</h2>
    <p class="text-muted">You don't have permission to view this page. Contact your society operator or administrator if you believe this is a mistake.</p>
