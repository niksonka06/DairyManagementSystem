@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Env
@using Microsoft.Extensions.Hosting
@{
    ViewData["Title"] = "Check your email";
    Layout = "_AuthLayout";
}

<div class="auth-card">
    <h2>Check your email</h2>
    <p class="lead">If that email is registered to an active account, we sent a password reset link. The link expires in 2 hours.</p>
    @if (Env.IsDevelopment())
    {
        <p class="lead">Email sending is off by default. Open the application log and copy the reset URL from the simulated email.</p>
    }
    else
    {
        <p class="lead">If you do not see the message, wait a minute and check spam.</p>
    }
    <a asp-action="Login" class="btn btn-primary w-100 py-2">Back to sign in</a>
</div>
