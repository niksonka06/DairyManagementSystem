@model AuditLogSearchViewModel
@{
    ViewData["Title"] = "Audit Log";
}

<h2 class="mb-4">Audit Log</h2>

<form method="get" class="row g-2 mb-4 align-items-end">
    <div class="col-auto">
        <label class="form-label">Entity Type</label>
        <select name="EntityType" class="form-select">
            <option value="">-- All --</option>
            @foreach (var t in Model.AvailableEntityTypes)
            {
                <option value="@t" selected="@(t == Model.EntityType)">@t</option>
            }
        </select>
    </div>
    <div class="col-auto">
        <label class="form-label">Entity ID</label>
        <input type="number" name="EntityID" value="@Model.EntityID" class="form-control" style="width: 8rem;" />
    </div>
    <div class="col-auto">
        <label class="form-label">From</label>
        <input type="date" name="FromDate" value="@(Model.FromDate?.ToString("yyyy-MM-dd"))" class="form-control" />
    </div>
    <div class="col-auto">
        <label class="form-label">To</label>
        <input type="date" name="ToDate" value="@(Model.ToDate?.ToString("yyyy-MM-dd"))" class="form-control" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">Filter</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
    </div>
</form>

<p class="text-muted">@Model.TotalCount total entries — page @Model.Page of @Math.Max(Model.TotalPages, 1)</p>

<table class="table table-striped table-hover">
    <thead>
        <tr><th>Timestamp</th><th>Entity</th><th>Action</th><th>Performed By</th><th>Details</th></tr>
    </thead>
    <tbody>
        @foreach (var log in Model.Items)
        {
            <tr>
                <td>@log.Timestamp.ToLocalTime().ToString("dd-MMM-yyyy HH:mm")</td>
                <td>@log.EntityType #@log.EntityID</td>
                <td><span class="badge bg-secondary">@log.Action</span></td>
                <td>@log.PerformedByName</td>
                <td>
                    @if (!string.IsNullOrEmpty(log.OldValue) || !string.IsNullOrEmpty(log.NewValue))
                    {
                        <details>
                            <summary class="text-primary" style="cursor: pointer;">View</summary>
                            @if (!string.IsNullOrEmpty(log.OldValue))
                            {
                                <div><strong>Old:</strong> <code>@log.OldValue</code></div>
                            }
                            @if (!string.IsNullOrEmpty(log.NewValue))
                            {
                                <div><strong>New:</strong> <code>@log.NewValue</code></div>
                            }
                        </details>
                    }
                </td>
            </tr>
        }
        @if (!Model.Items.Any())
        {
            <tr><td colspan="5" class="text-center text-muted">No audit entries match this filter.</td></tr>
        }
    </tbody>
</table>

@if (Model.TotalPages > 1)
{
    <nav>
        <ul class="pagination">
            @for (var p = 1; p <= Model.TotalPages; p++)
            {
                <li class="page-item @(p == Model.Page ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-EntityType="@Model.EntityType" asp-route-EntityID="@Model.EntityID"
                       asp-route-FromDate="@Model.FromDate?.ToString("yyyy-MM-dd")" asp-route-ToDate="@Model.ToDate?.ToString("yyyy-MM-dd")"
                       asp-route-Page="@p">@p</a>
                </li>
            }
        </ul>
    </nav>
}
