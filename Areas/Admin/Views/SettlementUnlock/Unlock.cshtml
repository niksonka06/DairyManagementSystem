@model SettlementUnlockViewModel
@{
    ViewData["Title"] = "Unlock Settlement";
}

<h2 class="mb-4">Unlock Settlement</h2>

<div class="alert alert-warning">
    This will cancel the settlement and unlock every collection and feed issue it locked, making them editable again. This action is audited.
</div>

<form asp-action="Unlock" method="post" class="col-md-6">
    <input type="hidden" asp-for="PaymentID" />
    <input type="hidden" asp-for="RowVersion" />

    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="mb-3">
        <label asp-for="Reason" class="form-label"></label>
        <textarea asp-for="Reason" class="form-control" rows="3" placeholder="Why is this settlement being unlocked?"></textarea>
        <span asp-validation-for="Reason" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-danger">Confirm Unlock</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
