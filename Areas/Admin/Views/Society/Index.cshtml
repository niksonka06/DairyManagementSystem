@model List<SocietyListItemViewModel>
@{
    ViewData["Title"] = "Societies";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Societies</h2>
    <a asp-action="Create" class="btn btn-primary">+ New Society</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<table class="table table-striped table-hover align-middle">
    <thead>
        <tr>
            <th>Society Name</th>
            <th>Registration No.</th>
            <th>Contact Phone</th>
            <th>Status</th>
            <th class="text-end">Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var s in Model)
        {
            <tr>
                <td>@s.SocietyName</td>
                <td>@s.RegistrationNo</td>
                <td>@s.ContactPhone</td>
                <td>
                    @if (s.IsActive)
                    {
                        <span class="badge bg-success">Active</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Inactive</span>
                    }
                </td>
                <td class="text-end">
                    <a asp-action="Edit" asp-route-id="@s.SocietyID" class="btn btn-sm btn-outline-primary">Edit</a>
                    <form asp-action="ToggleActive" asp-route-id="@s.SocietyID" method="post" class="d-inline">
                        <input type="hidden" name="activate" value="@(!s.IsActive)" />
                        @if (s.IsActive)
                        {
                            <button type="submit" class="btn btn-sm btn-outline-secondary">Deactivate</button>
                        }
                        else
                        {
                            <button type="submit" class="btn btn-sm btn-outline-success">Activate</button>
                        }
                    </form>
                </td>
            </tr>
        }
        @if (!Model.Any())
        {
            <tr><td colspan="5" class="text-center text-muted">No societies yet — create the first one.</td></tr>
        }
    </tbody>
</table>
