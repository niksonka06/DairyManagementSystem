@{
    ViewData["Title"] = "Admin Dashboard";
}

<h2 class="mb-4">Admin Dashboard</h2>

<div class="row g-3">
    <div class="col-auto">
        <div class="card" style="width: 20rem;">
            <div class="card-body">
                <h5 class="card-title">Societies</h5>
                <p class="card-text">Manage dairy societies — add, edit, activate/deactivate.</p>
                <a asp-controller="Society" asp-action="Index" class="btn btn-primary">Manage Societies</a>
            </div>
        </div>
    </div>
    <div class="col-auto">
        <div class="card" style="width: 20rem;">
            <div class="card-body">
                <h5 class="card-title">Operators</h5>
                <p class="card-text">Create Operator accounts and assign them to a society.</p>
                <a asp-controller="User" asp-action="Index" class="btn btn-primary">Manage Operators</a>
            </div>
        </div>
    </div>
    <div class="col-auto">
        <div class="card" style="width: 20rem;">
            <div class="card-body">
                <h5 class="card-title">Unlock Settlements</h5>
                <p class="card-text">Cancel & unlock a Generated settlement (requires reason).</p>
                <a asp-controller="SettlementUnlock" asp-action="Index" class="btn btn-primary">Unlock Settlements</a>
            </div>
        </div>
    </div>
    <div class="col-auto">
        <div class="card" style="width: 20rem;">
            <div class="card-body">
                <h5 class="card-title">Reports</h5>
                <p class="card-text">Cross-society reports — pick a society to view its data.</p>
                <a asp-area="" asp-controller="Reports" asp-action="Index" class="btn btn-primary">View Reports</a>
            </div>
        </div>
    </div>
</div>
