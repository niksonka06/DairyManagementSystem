@model PagedTable<OperatorListItemViewModel>
@{
    ViewData["Title"] = "Operators";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Operators</h2>
    <a asp-action="CreateOperator" class="btn btn-primary">+ New Operator</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="js-paged-table">
<table class="table table-striped table-hover align-middle">
    <thead>
        <tr>
            <sort-th column="code" title="Code" list="Model"></sort-th>
            <sort-th column="name" title="Name" list="Model"></sort-th>
            <sort-th column="email" title="Email" list="Model"></sort-th>
            <sort-th column="society" title="Society" list="Model"></sort-th>
            <sort-th column="status" title="Status" list="Model"></sort-th>
            <th class="text-end">Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var o in Model.Items)
        {
            <tr>
                <td>@(string.IsNullOrEmpty(o.StaffCode) || o.StaffCode == "—" ? "—" : o.StaffCode)</td>
                <td>@o.FullName</td>
                <td>@o.Email</td>
                <td>@o.SocietyName</td>
                <td>
                    @if (o.IsActive)
                    {
                        <span class="badge bg-success">Active</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Inactive</span>
                    }
                </td>
                <td class="text-end">
                    <a asp-action="EditOperator" asp-route-id="@o.UserId" class="btn btn-sm btn-outline-primary">Edit</a>
                    <form asp-action="ToggleActive" asp-route-id="@o.UserId" method="post" class="d-inline">
                        <input type="hidden" name="activate" value="@(o.IsActive ? "false" : "true")" />
                        @if (o.IsActive)
                        {
                            <button type="submit" class="btn btn-sm btn-outline-secondary">Deactivate</button>
                        }
                        else
                        {
                            <button type="submit" class="btn btn-sm btn-outline-success">Activate</button>
                        }
                    </form>
                </td>
            </tr>
        }
        @if (!Model.Items.Any())
        {
            <tr><td colspan="6" class="text-center text-muted">No operators yet.</td></tr>
        }
    </tbody>
</table>
<paged-pager list="Model"></paged-pager>
</div>
