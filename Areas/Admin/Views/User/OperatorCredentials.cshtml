@model OperatorCredentialsViewModel
@{
    ViewData["Title"] = "Operator Created";
}

<div class="alert alert-warning">
    <strong>Save these credentials now</strong> — the temporary password won't be shown again.
</div>

<h2 class="mb-4">Operator Account Created</h2>

<table class="table w-auto">
    <tr><th>Operator Code</th><td>@(string.IsNullOrEmpty(Model.StaffCode) ? "—" : Model.StaffCode)</td></tr>
    <tr><th>Name</th><td>@Model.FullName</td></tr>
    <tr><th>Login Email</th><td>@Model.LoginEmail</td></tr>
    <tr><th>Temporary Password</th><td><code>@Model.TemporaryPassword</code></td></tr>
</table>

<p class="text-muted">The Operator will be required to change this password on first login.</p>

<a asp-action="Index" class="btn btn-primary">Back to Operators</a>
