@model FarmerSettlementDetailViewModel
@{
    ViewData["Title"] = "Settlement Details";
}

<h2 class="mb-1">Settlement Details</h2>
<p class="text-muted">@Model.PeriodStart.ToString("dd-MMM-yyyy") to @Model.PeriodEnd.ToString("dd-MMM-yyyy")</p>

@{
    var badgeClass = Model.Status switch
    {
        SettlementStatus.Generated => "bg-warning text-dark",
        SettlementStatus.Paid => "bg-success",
        SettlementStatus.Cancelled => "bg-danger",
        _ => "bg-secondary"
    };
}
<p><span class="badge @badgeClass fs-6">@Model.Status</span></p>

<table class="table w-auto js-no-filter">
    <tr><th>Gross Amount</th><td>₹@Model.GrossAmount.ToString("0.00")</td></tr>
    <tr><th>Feed Deduction</th><td>−₹@Model.FeedDeduction.ToString("0.00")</td></tr>
    <tr><th>Medicine Deduction</th><td>−₹@Model.MedicineDeduction.ToString("0.00")</td></tr>
    @foreach (var line in Model.DeductionLines)
    {
        <tr><th>@line.Type Deduction</th><td>−₹@line.Amount.ToString("0.00")</td></tr>
    }
    <tr><th>Carry-forward</th><td>₹@Model.PreviousDue.ToString("0.00")</td></tr>
    <tr><th>Advance Paid</th><td>−₹@Model.AdvancePaid.ToString("0.00")</td></tr>
    <tr class="table-active"><th>Net Amount</th><td><strong>₹@Model.NetAmount.ToString("0.00")</strong></td></tr>
    @if (Model.PaidAt.HasValue)
    {
        <tr><th>Paid On</th><td>@Model.PaidAt.Value.ToString("dd-MMM-yyyy")</td></tr>
    }
</table>

@if (Model.NetAmount < 0)
{
    <div class="alert alert-warning">This week’s net is negative. It will be deducted from next week’s settlement.</div>
}

<a asp-action="Download" asp-route-id="@Model.PaymentID" class="btn btn-outline-primary">Download report</a>
<a asp-action="Index" class="btn btn-outline-secondary">Back to My Settlements</a>
