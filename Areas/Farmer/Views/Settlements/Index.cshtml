@model PagedTable<FarmerSettlementRowViewModel>
@{
    ViewData["Title"] = "My Settlements";
}

<h2 class="mb-4">My Settlements</h2>

<div class="js-paged-table">
<table class="table table-striped table-hover">
    <thead>
        <tr>
            <sort-th column="period" title="Period" list="Model"></sort-th>
            <sort-th column="amount" title="Net Amount" list="Model"></sort-th>
            <sort-th column="status" title="Status" list="Model"></sort-th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var s in Model.Items)
        {
            <tr>
                <td>@s.PeriodStart.ToString("dd-MMM-yyyy") to @s.PeriodEnd.ToString("dd-MMM-yyyy")</td>
                <td>₹@s.NetAmount.ToString("0.00")</td>
                <td>
                    @{
                        var badgeClass = s.Status switch
                        {
                            SettlementStatus.Draft => "bg-secondary",
                            SettlementStatus.Generated => "bg-warning text-dark",
                            SettlementStatus.Paid => "bg-success",
                            SettlementStatus.Cancelled => "bg-danger",
                            _ => "bg-secondary"
                        };
                    }
                    <span class="badge @badgeClass">@s.Status</span>
                </td>
                <td>
                    <a asp-action="Details" asp-route-id="@s.PaymentID" class="btn btn-sm btn-outline-primary">View</a>
                    <a asp-action="Download" asp-route-id="@s.PaymentID" class="btn btn-sm btn-outline-secondary">PDF</a>
                </td>
            </tr>
        }
        @if (!Model.Items.Any())
        {
            <tr><td colspan="4" class="text-center text-muted">No settlements yet.</td></tr>
        }
    </tbody>
</table>
<paged-pager list="Model"></paged-pager>
</div>
