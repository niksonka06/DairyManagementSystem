@model List<FarmerCollectionRowViewModel>
@{
    ViewData["Title"] = "My Milk Records";
    DateTime fromDate = ViewBag.FromDate;
    DateTime toDate = ViewBag.ToDate;
}

<h2 class="mb-4">My Milk Records</h2>

<form method="get" class="row g-2 mb-4 align-items-end">
    <div class="col-auto">
        <label class="form-label">From</label>
        <input type="date" name="from" value="@fromDate.ToString("yyyy-MM-dd")" class="form-control" />
    </div>
    <div class="col-auto">
        <label class="form-label">To</label>
        <input type="date" name="to" value="@toDate.ToString("yyyy-MM-dd")" class="form-control" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">View</button>
    </div>
</form>

<table class="table table-striped table-hover">
    <thead><tr><th>Date</th><th>Shift</th><th>Qty (L)</th><th>Fat %</th><th>SNF</th><th>Rate</th><th>Amount</th><th>Status</th></tr></thead>
    <tbody>
        @foreach (var r in Model)
        {
            <tr>
                <td>@r.CollectionDate.ToString("dd-MMM-yyyy")</td>
                <td>@r.Shift</td>
                <td>@r.Quantity.ToString("0.00")</td>
                <td>@r.FatPercent.ToString("0.0")</td>
                <td>@(r.SNF.HasValue ? r.SNF.Value.ToString("0.0") : "—")</td>
                <td>₹@r.RatePerLitre.ToString("0.00")</td>
                <td>₹@r.Amount.ToString("0.00")</td>
                <td>
                    @if (r.IsLocked)
                    {
                        <span class="badge bg-warning text-dark">Settled</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Pending</span>
                    }
                </td>
            </tr>
        }
        @if (!Model.Any())
        {
            <tr><td colspan="8" class="text-center text-muted">No records in this period.</td></tr>
        }
    </tbody>
    @if (Model.Any())
    {
        <tfoot>
            <tr class="table-active">
                <th colspan="2">Total</th>
                <th>@Model.Sum(r => r.Quantity).ToString("0.00")</th>
                <th colspan="3"></th>
                <th>₹@Model.Sum(r => r.Amount).ToString("0.00")</th>
                <th></th>
            </tr>
        </tfoot>
    }
</table>
