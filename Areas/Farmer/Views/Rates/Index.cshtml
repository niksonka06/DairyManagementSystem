@model PagedTable<MilkRateListItemViewModel>
@{
    ViewData["Title"] = "Milk Rate Chart";
}

<h2 class="mb-3">Society Milk Rate Chart</h2>
<p class="text-muted">These are the fat / SNF / CLR bands used to calculate your milk payment. A collection matches when all three values fall inside an active band on the chart that is effective on that date.</p>

<div class="js-paged-table">
<table class="table table-striped table-hover align-middle">
    <thead>
        <tr>
            <sort-th column="fat" title="Fat %" list="Model"></sort-th>
            <sort-th column="snf" title="SNF" list="Model"></sort-th>
            <sort-th column="clr" title="CLR" list="Model"></sort-th>
            <sort-th column="rate" title="Rate / Litre (₹)" list="Model"></sort-th>
            <sort-th column="effective" title="Effective From" list="Model"></sort-th>
            <sort-th column="status" title="Status" list="Model"></sort-th>
        </tr>
    </thead>
    <tbody>
        @foreach (var r in Model.Items)
        {
            <tr>
                <td>@r.FatPercentFrom.ToString("0.00")–@r.FatPercentTo.ToString("0.00")</td>
                <td>@r.SnfPercentFrom.ToString("0.00")–@r.SnfPercentTo.ToString("0.00")</td>
                <td>@r.ClrFrom.ToString("0.00")–@r.ClrTo.ToString("0.00")</td>
                <td>₹@r.RatePerLitre.ToString("0.00")</td>
                <td>@r.EffectiveFrom.ToString("dd-MMM-yyyy")</td>
                <td>
                    @if (r.IsActive)
                    {
                        <span class="badge bg-success">Active</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Inactive</span>
                    }
                </td>
            </tr>
        }
        @if (!Model.Items.Any())
        {
            <tr><td colspan="6" class="text-center text-muted">No rate chart is published for your society yet.</td></tr>
        }
    </tbody>
</table>
<paged-pager list="Model"></paged-pager>
</div>
