@model PagedTable<DispatchListItemViewModel>
@{
    ViewData["Title"] = "Dispatch";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Dispatch & Reconciliation</h2>
    <a asp-action="Create" class="btn btn-primary">+ Record Dispatch</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="js-paged-table">
<table class="table table-striped table-hover align-middle">
    <thead>
        <tr>
            <sort-th column="date" title="Date" list="Model"></sort-th>
            <sort-th column="vehicle" title="Vehicle" list="Model"></sort-th>
            <sort-th column="dest" title="Destination" list="Model"></sort-th>
            <sort-th column="collected" title="Collected (L)" list="Model"></sort-th>
            <sort-th column="dispatched" title="Dispatched (L)" list="Model"></sort-th>
            <sort-th column="variance" title="Variance" list="Model"></sort-th>
            <th class="text-end">Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var d in Model.Items)
        {
            <tr>
                <td>@d.DispatchDate.ToString("dd-MMM-yyyy")</td>
                <td>@d.VehicleNo</td>
                <td>@d.Destination</td>
                <td>@d.TotalCollected.ToString("0.00")</td>
                <td>@d.TotalDispatched.ToString("0.00")</td>
                <td>
                    @d.Variance.ToString("0.00")L (@d.VariancePercent.ToString("0.0")%)
                    @if (!string.IsNullOrEmpty(d.VarianceReason))
                    {
                        <br /><small class="text-muted">@d.VarianceReason</small>
                    }
                </td>
                <td class="text-end">
                    <a asp-action="Edit" asp-route-id="@d.DispatchID" class="btn btn-sm btn-outline-primary">Edit</a>
                </td>
            </tr>
        }
        @if (!Model.Items.Any())
        {
            <tr><td colspan="7" class="text-center text-muted">No dispatch records yet.</td></tr>
        }
    </tbody>
</table>
<paged-pager list="Model"></paged-pager>
</div>
