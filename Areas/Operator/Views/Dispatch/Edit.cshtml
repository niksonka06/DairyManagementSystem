@model DispatchFormViewModel
@{
    ViewData["Title"] = "Edit Dispatch";
}

<h2 class="mb-4">Edit Dispatch</h2>

<form asp-action="Edit" method="post" class="col-md-6">
    <input type="hidden" asp-for="DispatchID" />
    <input type="hidden" asp-for="RowVersion" />

    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="DispatchDate" class="form-label"></label>
            <input asp-for="DispatchDate" class="form-control" />
            <span asp-validation-for="DispatchDate" class="text-danger"></span>
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="DispatchTime" class="form-label"></label>
            <input asp-for="DispatchTime" class="form-control" />
            <span asp-validation-for="DispatchTime" class="text-danger"></span>
        </div>
    </div>

    <div class="mb-3">
        <label asp-for="VehicleNo" class="form-label"></label>
        <input asp-for="VehicleNo" class="form-control" />
        <span asp-validation-for="VehicleNo" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Destination" class="form-label"></label>
        <input asp-for="Destination" class="form-control" />
        <span asp-validation-for="Destination" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="TotalCollected" class="form-label"></label>
        <input asp-for="TotalCollected" class="form-control" type="number" step="0.01" readonly tabindex="-1" />
        <div class="form-text">Sum of milk collections for the dispatch date. Recalculated on save.</div>
    </div>

    <div class="mb-3">
        <label asp-for="TotalDispatched" class="form-label"></label>
        <input asp-for="TotalDispatched" class="form-control" type="number" step="0.01" min="0.01" />
        <span asp-validation-for="TotalDispatched" class="text-danger"></span>
        <div class="form-text">Tanker reading. Not overwritten when the date changes.</div>
    </div>

    <div class="mb-3">
        <label asp-for="VarianceReason" class="form-label"></label>
        <textarea asp-for="VarianceReason" class="form-control" rows="2"></textarea>
        <span asp-validation-for="VarianceReason" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Save Changes</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <partial name="_DispatchCollectedScript" />
}
