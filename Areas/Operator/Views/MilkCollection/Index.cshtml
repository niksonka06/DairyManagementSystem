@model MilkCollectionPageViewModel
@{
    ViewData["Title"] = "Milk Collection";
    ViewData["FillViewport"] = true;
    var selectedDate = Model.SelectedDate;
}

<div class="milk-collect-page">
    <div class="milk-collect-toolbar">
        <h2>Milk Collection</h2>
        <form method="get" class="milk-collect-date">
            <label class="form-label mb-0" for="collection-day">Date</label>
            <input id="collection-day" type="date" name="date" value="@selectedDate.ToString("yyyy-MM-dd")" class="form-control form-control-sm" onchange="this.form.submit()" />
        </form>
        <div class="milk-collect-stats">
            <span><strong>@Model.DayTotalQuantity.ToString("0.00") L</strong> quantity</span>
            <span><strong>₹@Model.DayTotalAmount.ToString("0.00")</strong> amount</span>
            <span><strong>@Model.Collections.TotalCount</strong> entries</span>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success py-2 px-3 mb-0">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger py-2 px-3 mb-0">@TempData["Error"]</div>
    }

    <div class="milk-collect-layout">
        <div class="milk-collect-form-col">
            <div class="card milk-collect-card">
                <div class="card-header py-2 px-3">
                    <strong>Record collection</strong>
                </div>
                <div class="card-body">
                    <form asp-action="Create" method="post" class="milk-collect-form">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

                        <div class="mb-2">
                            <label asp-for="Form.FarmerID" class="form-label"></label>
                            <select asp-for="Form.FarmerID" class="form-select form-select-sm" autofocus>
                                <option value="">-- Select Farmer --</option>
                                @foreach (var f in Model.Form.AvailableFarmers)
                                {
                                    <option value="@f.FarmerID">@f.FarmerCode — @f.FullName</option>
                                }
                            </select>
                            <span asp-validation-for="Form.FarmerID" class="text-danger"></span>
                        </div>

                        <div class="row g-2">
                            <div class="col-6 mb-2">
                                <label asp-for="Form.CollectionDate" class="form-label"></label>
                                <input asp-for="Form.CollectionDate" class="form-control form-control-sm" />
                                <span asp-validation-for="Form.CollectionDate" class="text-danger"></span>
                            </div>
                            <div class="col-6 mb-2">
                                <label asp-for="Form.Shift" class="form-label"></label>
                                <select asp-for="Form.Shift" class="form-select form-select-sm">
                                    <option value="Morning">Morning</option>
                                    <option value="Evening">Evening</option>
                                </select>
                                <span asp-validation-for="Form.Shift" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-2">
                            <label asp-for="Form.Quantity" class="form-label"></label>
                            <input asp-for="Form.Quantity" class="form-control form-control-sm" type="number" step="0.01" min="0.5" max="500" />
                            <span asp-validation-for="Form.Quantity" class="text-danger"></span>
                        </div>

                        <div class="row g-2">
                            <div class="col-4 mb-2">
                                <label asp-for="Form.FatPercent" class="form-label"></label>
                                <input asp-for="Form.FatPercent" class="form-control form-control-sm" type="number" step="0.1" min="2.5" max="9.0" />
                                <span asp-validation-for="Form.FatPercent" class="text-danger"></span>
                            </div>
                            <div class="col-4 mb-2">
                                <label asp-for="Form.SNF" class="form-label"></label>
                                <input asp-for="Form.SNF" class="form-control form-control-sm" type="number" step="0.1" min="7.5" max="11.0" />
                                <span asp-validation-for="Form.SNF" class="text-danger"></span>
                            </div>
                            <div class="col-4 mb-2">
                                <label asp-for="Form.CLR" class="form-label"></label>
                                <input asp-for="Form.CLR" class="form-control form-control-sm" type="number" step="1" min="0" max="50" />
                                <span asp-validation-for="Form.CLR" class="text-danger"></span>
                            </div>
                        </div>

                        <p class="text-muted small mb-2">Rate and amount come from the milk rate chart when you save.</p>

                        <button type="submit" class="btn btn-primary milk-collect-submit">Record Collection</button>
                    </form>
                </div>
            </div>
        </div>

        <div class="milk-collect-list-col">
            <div class="card milk-collect-card">
                <div class="card-body milk-collect-table-wrap js-paged-table">
                    <table class="table table-striped table-hover table-sm align-middle mb-0">
                        <thead>
                            <tr>
                                <sort-th column="shift" title="Shift" list="Model.Collections"></sort-th>
                                <sort-th column="farmer" title="Farmer" list="Model.Collections"></sort-th>
                                <sort-th column="qty" title="Qty (L)" list="Model.Collections"></sort-th>
                                <sort-th column="fat" title="Fat %" list="Model.Collections"></sort-th>
                                <sort-th column="snf" title="SNF" list="Model.Collections"></sort-th>
                                <sort-th column="clr" title="CLR" list="Model.Collections"></sort-th>
                                <sort-th column="rate" title="Rate" list="Model.Collections"></sort-th>
                                <sort-th column="amount" title="Amount" list="Model.Collections"></sort-th>
                                <sort-th column="status" title="Status" list="Model.Collections"></sort-th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var c in Model.Collections.Items)
                            {
                                <tr>
                                    <td>@c.Shift</td>
                                    <td>@c.FarmerCode — @c.FarmerName</td>
                                    <td>@c.Quantity.ToString("0.00")</td>
                                    <td>@c.FatPercent.ToString("0.0")</td>
                                    <td>@(c.SNF.HasValue ? c.SNF.Value.ToString("0.0") : "—")</td>
                                    <td>@(c.CLR.HasValue ? c.CLR.Value.ToString("0.0") : "—")</td>
                                    <td>₹@c.RatePerLitre.ToString("0.00")</td>
                                    <td>₹@c.Amount.ToString("0.00")</td>
                                    <td>
                                        @if (c.IsLocked)
                                        {
                                            <span class="badge bg-warning text-dark">Locked</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">Open</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        @if (!c.IsLocked)
                                        {
                                            <a asp-action="Edit" asp-route-id="@c.CollectionID" class="btn btn-sm btn-outline-primary">Edit</a>
                                        }
                                    </td>
                                </tr>
                            }
                            @if (!Model.Collections.Items.Any())
                            {
                                <tr><td colspan="10" class="text-center text-muted">No collections recorded for this date.</td></tr>
                            }
                        </tbody>
                    </table>
                    <paged-pager list="Model.Collections"></paged-pager>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
