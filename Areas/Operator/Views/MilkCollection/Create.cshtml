@model MilkCollectionFormViewModel
@{
    ViewData["Title"] = "Record Collection";
}

<h2 class="mb-4">Record Collection</h2>

<form asp-action="Create" method="post" class="col-md-6">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="mb-3">
        <label asp-for="FarmerID" class="form-label"></label>
        <select asp-for="FarmerID" class="form-select">
            <option value="">-- Select Farmer --</option>
            @foreach (var f in Model.AvailableFarmers)
            {
                <option value="@f.FarmerID">@f.FarmerCode — @f.FullName</option>
            }
        </select>
        <span asp-validation-for="FarmerID" class="text-danger"></span>
    </div>

    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="CollectionDate" class="form-label"></label>
            <input asp-for="CollectionDate" class="form-control" />
            <span asp-validation-for="CollectionDate" class="text-danger"></span>
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="Shift" class="form-label"></label>
            <select asp-for="Shift" class="form-select">
                <option value="Morning">Morning</option>
                <option value="Evening">Evening</option>
            </select>
            <span asp-validation-for="Shift" class="text-danger"></span>
        </div>
    </div>

    <div class="mb-3">
        <label asp-for="Quantity" class="form-label"></label>
        <input asp-for="Quantity" class="form-control" type="number" step="0.01" min="0.5" max="500" />
        <span asp-validation-for="Quantity" class="text-danger"></span>
    </div>

    <div class="row">
        <div class="col-md-4 mb-3">
            <label asp-for="FatPercent" class="form-label"></label>
            <input asp-for="FatPercent" class="form-control" type="number" step="0.1" min="2.5" max="9.0" />
            <span asp-validation-for="FatPercent" class="text-danger"></span>
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="SNF" class="form-label"></label>
            <input asp-for="SNF" class="form-control" type="number" step="0.1" min="7.5" max="11.0" />
            <span asp-validation-for="SNF" class="text-danger"></span>
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="CLR" class="form-label"></label>
            <input asp-for="CLR" class="form-control" type="number" step="0.1" />
            <span asp-validation-for="CLR" class="text-danger"></span>
        </div>
    </div>

    <p class="text-muted">Rate and amount are calculated automatically from the Milk Rate Chart once you submit.</p>

    <button type="submit" class="btn btn-primary">Record Collection</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
