@model List<FarmerListItemViewModel>
@{
    ViewData["Title"] = "Farmers";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Farmers</h2>
    <a asp-action="Create" class="btn btn-primary">+ New Farmer</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<table class="table table-striped table-hover align-middle">
    <thead>
        <tr>
            <th>Farmer Code</th>
            <th>Name</th>
            <th>Phone</th>
            <th>Status</th>
            <th class="text-end">Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var f in Model)
        {
            <tr>
                <td>@f.FarmerCode</td>
                <td>@f.FullName</td>
                <td>@f.Phone</td>
                <td>
                    @if (f.IsActive)
                    {
                        <span class="badge bg-success">Active</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Inactive</span>
                    }
                </td>
                <td class="text-end">
                    <a asp-action="Edit" asp-route-id="@f.FarmerID" class="btn btn-sm btn-outline-primary">Edit</a>
                    <form asp-action="ToggleActive" asp-route-id="@f.FarmerID" method="post" class="d-inline">
                        <input type="hidden" name="activate" value="@(!f.IsActive)" />
                        @if (f.IsActive)
                        {
                            <button type="submit" class="btn btn-sm btn-outline-secondary">Deactivate</button>
                        }
                        else
                        {
                            <button type="submit" class="btn btn-sm btn-outline-success">Activate</button>
                        }
                    </form>
                </td>
            </tr>
        }
        @if (!Model.Any())
        {
            <tr><td colspan="5" class="text-center text-muted">No farmers yet — register the first one.</td></tr>
        }
    </tbody>
</table>
