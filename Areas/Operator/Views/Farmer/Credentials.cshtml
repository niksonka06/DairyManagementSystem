@model FarmerCredentialsViewModel
@{
    ViewData["Title"] = "Farmer Registered";
}

<div class="alert alert-warning">
    <strong>Save these credentials now</strong> — the temporary password won't be shown again. Share them with the farmer securely.
</div>

<h2 class="mb-4">Farmer Registered</h2>

<table class="table w-auto">
    <tr><th>Name</th><td>@Model.FullName</td></tr>
    <tr><th>Farmer Code</th><td>@Model.FarmerCode</td></tr>
    <tr><th>Login Email</th><td>@Model.LoginEmail</td></tr>
    <tr><th>Temporary Password</th><td><code>@Model.TemporaryPassword</code></td></tr>
</table>

<p class="text-muted">The farmer will be required to change this password on first login.</p>

<a asp-action="Index" class="btn btn-primary">Back to Farmers</a>
