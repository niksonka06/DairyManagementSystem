@model AddStockViewModel
@{
    ViewData["Title"] = "Add Stock";
}

<h2 class="mb-4">Add Stock — @Model.FeedName</h2>

<form asp-action="AddStock" method="post" class="col-md-4">
    <input type="hidden" asp-for="FeedItemID" />

    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="mb-3">
        <label asp-for="QuantityToAdd" class="form-label"></label>
        <input asp-for="QuantityToAdd" class="form-control" type="number" step="0.01" min="0.01" autofocus />
        <span asp-validation-for="QuantityToAdd" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-success">Add to Stock</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
