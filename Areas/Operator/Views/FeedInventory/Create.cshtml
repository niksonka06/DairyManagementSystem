@model FeedInventoryFormViewModel
@{
    ViewData["Title"] = "New Item";
}

<h2 class="mb-4">New Item</h2>

<form asp-action="Create" method="post" class="col-md-5">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="mb-3">
        <label asp-for="ItemType" class="form-label"></label>
        <select asp-for="ItemType" class="form-select">
            <option value="Feed">Feed</option>
            <option value="Medicine">Medicine</option>
        </select>
        <span asp-validation-for="ItemType" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="FeedName" class="form-label"></label>
        <input asp-for="FeedName" class="form-control" />
        <span asp-validation-for="FeedName" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Unit" class="form-label"></label>
        <input asp-for="Unit" class="form-control" placeholder="e.g. kg, packet, bottle" />
        <span asp-validation-for="Unit" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="PricePerUnit" class="form-label"></label>
        <input asp-for="PricePerUnit" class="form-control" type="number" step="0.01" min="0.01" />
        <span asp-validation-for="PricePerUnit" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="LowStockThreshold" class="form-label"></label>
        <input asp-for="LowStockThreshold" class="form-control" type="number" step="0.01" min="0" />
        <span asp-validation-for="LowStockThreshold" class="text-danger"></span>
    </div>

    <p class="text-muted">Stock starts at 0 — use "Add Stock" after creating to record initial quantity.</p>

    <button type="submit" class="btn btn-primary">Create Item</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
