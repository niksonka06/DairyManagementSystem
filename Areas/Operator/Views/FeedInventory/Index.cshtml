@model PagedTable<FeedInventoryListItemViewModel>
@{
    ViewData["Title"] = "Feed & Medicine Inventory";
    var lowStockCount = (int)(ViewBag.LowStockCount ?? 0);
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Feed & Medicine Inventory</h2>
    <a asp-action="Create" class="btn btn-primary">+ New Item</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@if (lowStockCount > 0)
{
    <div class="alert alert-warning">⚠ @lowStockCount item(s) at or below their low-stock threshold.</div>
}

<div class="js-paged-table">
<table class="table table-striped table-hover align-middle">
    <thead>
        <tr>
            <sort-th column="type" title="Type" list="Model"></sort-th>
            <sort-th column="name" title="Name" list="Model"></sort-th>
            <sort-th column="unit" title="Unit" list="Model"></sort-th>
            <sort-th column="price" title="Price/Unit" list="Model"></sort-th>
            <sort-th column="stock" title="Stock" list="Model"></sort-th>
            <sort-th column="status" title="Status" list="Model"></sort-th>
            <th class="text-end">Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var f in Model.Items)
        {
            <tr>
                <td>@f.ItemType</td>
                <td>@f.FeedName</td>
                <td>@f.Unit</td>
                <td>₹@f.PricePerUnit.ToString("0.00")</td>
                <td>
                    @f.StockQuantity.ToString("0.00")
                    @if (f.IsLowStock)
                    {
                        <span class="badge bg-warning text-dark">Low</span>
                    }
                </td>
                <td>
                    @if (f.IsActive)
                    {
                        <span class="badge bg-success">Active</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Inactive</span>
                    }
                </td>
                <td class="text-end">
                    <a asp-action="AddStock" asp-route-id="@f.FeedItemID" class="btn btn-sm btn-outline-success">Add Stock</a>
                    <a asp-action="Edit" asp-route-id="@f.FeedItemID" class="btn btn-sm btn-outline-primary">Edit</a>
                    <form asp-action="ToggleActive" asp-route-id="@f.FeedItemID" method="post" class="d-inline">
                        <input type="hidden" name="activate" value="@(f.IsActive ? "false" : "true")" />
                        @if (f.IsActive)
                        {
                            <button type="submit" class="btn btn-sm btn-outline-secondary">Deactivate</button>
                        }
                        else
                        {
                            <button type="submit" class="btn btn-sm btn-outline-success">Activate</button>
                        }
                    </form>
                </td>
            </tr>
        }
        @if (!Model.Items.Any())
        {
            <tr><td colspan="7" class="text-center text-muted">No items yet — add the first one.</td></tr>
        }
    </tbody>
</table>
<paged-pager list="Model"></paged-pager>
</div>
