@model AdvancePaymentFormViewModel
@{
    ViewData["Title"] = "Record Advance";
}

<h2 class="mb-4">Record Advance Payment</h2>

<form asp-action="Create" method="post" class="col-md-5">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="mb-3">
        <label asp-for="FarmerID" class="form-label"></label>
        <select asp-for="FarmerID" class="form-select">
            <option value="">-- Select Farmer --</option>
            @foreach (var f in Model.AvailableFarmers)
            {
                <option value="@f.FarmerID">@f.FarmerCode — @f.FullName</option>
            }
        </select>
        <span asp-validation-for="FarmerID" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Amount" class="form-label"></label>
        <input asp-for="Amount" class="form-control" type="number" step="0.01" min="0.01" />
        <span asp-validation-for="Amount" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="PaymentDate" class="form-label"></label>
        <input asp-for="PaymentDate" class="form-control" />
        <span asp-validation-for="PaymentDate" class="text-danger"></span>
    </div>

    <p class="text-muted">This amount will automatically apply to this farmer's next settlement when it's generated.</p>

    <button type="submit" class="btn btn-primary">Record Advance</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
