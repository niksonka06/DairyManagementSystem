@model List<AdvancePaymentListItemViewModel>
@{
    ViewData["Title"] = "Advance Payments";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Advance Payments</h2>
    <a asp-action="Create" class="btn btn-primary">+ Record Advance</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<table class="table table-striped table-hover align-middle">
    <thead>
        <tr>
            <th>Date</th>
            <th>Farmer</th>
            <th>Amount</th>
            <th>Status</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var a in Model)
        {
            <tr>
                <td>@a.PaymentDate.ToString("dd-MMM-yyyy")</td>
                <td>@a.FarmerCode — @a.FarmerName</td>
                <td>₹@a.Amount.ToString("0.00")</td>
                <td>
                    @if (a.IsApplied)
                    {
                        <span class="badge bg-success">Applied</span>
                    }
                    else
                    {
                        <span class="badge bg-warning text-dark">Pending</span>
                    }
                </td>
            </tr>
        }
        @if (!Model.Any())
        {
            <tr><td colspan="4" class="text-center text-muted">No advances recorded yet.</td></tr>
        }
    </tbody>
</table>
