@model List<MilkRateListItemViewModel>
@{
    ViewData["Title"] = "Milk Rate Chart";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Milk Rate Chart</h2>
    <a asp-action="Create" class="btn btn-primary">+ New Rate</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<p class="text-muted">Enter fat, SNF and CLR bands as from–to. A collection matches when all three values fall inside a band on the latest chart that is effective on that date.</p>

<table class="table table-striped table-hover align-middle">
    <thead>
        <tr>
            <th>Fat %</th>
            <th>SNF</th>
            <th>CLR</th>
            <th>Rate / Litre (₹)</th>
            <th>Effective From</th>
            <th>Status</th>
            <th class="text-end">Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var r in Model)
        {
            <tr>
                <td>@r.FatPercentFrom.ToString("0.00")–@r.FatPercentTo.ToString("0.00")</td>
                <td>@r.SnfPercentFrom.ToString("0.00")–@r.SnfPercentTo.ToString("0.00")</td>
                <td>@r.ClrFrom.ToString("0.00")–@r.ClrTo.ToString("0.00")</td>
                <td>₹@r.RatePerLitre.ToString("0.00")</td>
                <td>@r.EffectiveFrom.ToString("dd-MMM-yyyy")</td>
                <td>
                    @if (r.IsActive)
                    {
                        <span class="badge bg-success">Active</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Inactive</span>
                    }
                </td>
                <td class="text-end">
                    <a asp-action="Edit" asp-route-id="@r.RateID" class="btn btn-sm btn-outline-primary">Edit</a>
                    <form asp-action="ToggleActive" asp-route-id="@r.RateID" method="post" class="d-inline">
                        <input type="hidden" name="activate" value="@(r.IsActive ? "false" : "true")" />
                        @if (r.IsActive)
                        {
                            <button type="submit" class="btn btn-sm btn-outline-secondary">Deactivate</button>
                        }
                        else
                        {
                            <button type="submit" class="btn btn-sm btn-outline-success">Activate</button>
                        }
                    </form>
                </td>
            </tr>
        }
        @if (!Model.Any())
        {
            <tr><td colspan="7" class="text-center text-muted">No rates yet — add the first one.</td></tr>
        }
    </tbody>
</table>
