@model MilkRateFormViewModel
@{
    ViewData["Title"] = "Edit Rate";
}

<h2 class="mb-4">Edit Rate</h2>

<form asp-action="Edit" method="post" class="col-md-5">
    <input type="hidden" asp-for="RateID" />
    <input type="hidden" asp-for="RowVersion" />

    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="mb-3">
        <label asp-for="FatPercent" class="form-label"></label>
        <input asp-for="FatPercent" class="form-control" type="number" step="0.1" min="2.5" max="9.0" />
        <span asp-validation-for="FatPercent" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="RatePerLitre" class="form-label"></label>
        <input asp-for="RatePerLitre" class="form-control" type="number" step="0.01" min="0.01" />
        <span asp-validation-for="RatePerLitre" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="EffectiveFrom" class="form-label"></label>
        <input asp-for="EffectiveFrom" class="form-control" />
        <span asp-validation-for="EffectiveFrom" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Save Changes</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
