@model MilkRateFormViewModel
@{
    ViewData["Title"] = "New Rate";
}

<h2 class="mb-4">New Rate</h2>
<p class="text-muted">A collection matches a band when its fat %, SNF and CLR all fall inside the from–to ranges. Example: fat 3.00–3.49, SNF 8.00–8.50, CLR 28–30 at ₹34.</p>

<form asp-action="Create" method="post" class="col-md-8">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="FatPercentFrom" class="form-label"></label>
            <input asp-for="FatPercentFrom" class="form-control" type="number" step="0.01" min="2.5" max="9.0" />
            <span asp-validation-for="FatPercentFrom" class="text-danger"></span>
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="FatPercentTo" class="form-label"></label>
            <input asp-for="FatPercentTo" class="form-control" type="number" step="0.01" min="2.5" max="9.0" />
            <span asp-validation-for="FatPercentTo" class="text-danger"></span>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="SnfPercentFrom" class="form-label"></label>
            <input asp-for="SnfPercentFrom" class="form-control" type="number" step="0.01" min="7.5" max="11.0" />
            <span asp-validation-for="SnfPercentFrom" class="text-danger"></span>
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="SnfPercentTo" class="form-label"></label>
            <input asp-for="SnfPercentTo" class="form-control" type="number" step="0.01" min="7.5" max="11.0" />
            <span asp-validation-for="SnfPercentTo" class="text-danger"></span>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="ClrFrom" class="form-label"></label>
            <input asp-for="ClrFrom" class="form-control" type="number" step="0.01" min="0" max="50" />
            <span asp-validation-for="ClrFrom" class="text-danger"></span>
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="ClrTo" class="form-label"></label>
            <input asp-for="ClrTo" class="form-control" type="number" step="0.01" min="0" max="50" />
            <span asp-validation-for="ClrTo" class="text-danger"></span>
        </div>
    </div>

    <div class="mb-3">
        <label asp-for="RatePerLitre" class="form-label"></label>
        <input asp-for="RatePerLitre" class="form-control" type="number" step="0.01" min="0.01" />
        <span asp-validation-for="RatePerLitre" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="EffectiveFrom" class="form-label"></label>
        <input asp-for="EffectiveFrom" class="form-control" />
        <span asp-validation-for="EffectiveFrom" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Add Rate</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
