@model FeedIssueFormViewModel
@{
    ViewData["Title"] = "Issue to Farmer";
}

<h2 class="mb-4">Issue to Farmer</h2>

<form asp-action="Create" method="post" class="col-md-6">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="mb-3">
        <label asp-for="FarmerID" class="form-label"></label>
        <select asp-for="FarmerID" class="form-select">
            <option value="">-- Select Farmer --</option>
            @foreach (var f in Model.AvailableFarmers)
            {
                <option value="@f.FarmerID">@f.FarmerCode — @f.FullName</option>
            }
        </select>
        <span asp-validation-for="FarmerID" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="FeedItemID" class="form-label"></label>
        <select asp-for="FeedItemID" class="form-select">
            <option value="">-- Select Item --</option>
            @foreach (var item in Model.AvailableItems)
            {
                <option value="@item.FeedItemID">@item.ItemType — @item.FeedName (@item.StockQuantity.ToString("0.00") @item.Unit in stock, ₹@item.PricePerUnit.ToString("0.00")/@item.Unit)</option>
            }
        </select>
        <span asp-validation-for="FeedItemID" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Quantity" class="form-label"></label>
        <input asp-for="Quantity" class="form-control" type="number" step="0.01" min="0.01" />
        <span asp-validation-for="Quantity" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="IssueDate" class="form-label"></label>
        <input asp-for="IssueDate" class="form-control" />
        <span asp-validation-for="IssueDate" class="text-danger"></span>
    </div>

    <p class="text-muted">Cost is calculated automatically at the item's current price per unit, and deducted from farmer's next settlement.</p>

    <button type="submit" class="btn btn-primary">Issue Item</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
