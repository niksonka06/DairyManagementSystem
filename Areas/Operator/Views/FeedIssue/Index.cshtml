@model List<FeedIssueListItemViewModel>
@{
    ViewData["Title"] = "Feed / Medicine Issues";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Feed / Medicine Issues</h2>
    <a asp-action="Create" class="btn btn-primary">+ Issue to Farmer</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<table class="table table-striped table-hover align-middle">
    <thead>
        <tr>
            <th>Date</th>
            <th>Farmer</th>
            <th>Type</th>
            <th>Item</th>
            <th>Quantity</th>
            <th>Total Cost</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var i in Model)
        {
            <tr>
                <td>@i.IssueDate.ToString("dd-MMM-yyyy")</td>
                <td>@i.FarmerCode — @i.FarmerName</td>
                <td>@i.ItemType</td>
                <td>@i.FeedName</td>
                <td>@i.Quantity.ToString("0.00")</td>
                <td>₹@i.TotalCost.ToString("0.00")</td>
            </tr>
        }
        @if (!Model.Any())
        {
            <tr><td colspan="6" class="text-center text-muted">No issues recorded yet.</td></tr>
        }
    </tbody>
</table>
