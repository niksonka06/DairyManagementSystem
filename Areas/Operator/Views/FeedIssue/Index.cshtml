@model PagedTable<FeedIssueListItemViewModel>
@{
    ViewData["Title"] = "Feed / Medicine Issues";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Feed / Medicine Issues</h2>
    <a asp-action="Create" class="btn btn-primary">+ Issue to Farmer</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="js-paged-table">
<table class="table table-striped table-hover align-middle">
    <thead>
        <tr>
            <sort-th column="date" title="Date" list="Model"></sort-th>
            <sort-th column="farmer" title="Farmer" list="Model"></sort-th>
            <sort-th column="type" title="Type" list="Model"></sort-th>
            <sort-th column="item" title="Item" list="Model"></sort-th>
            <sort-th column="qty" title="Quantity" list="Model"></sort-th>
            <sort-th column="cost" title="Total Cost" list="Model"></sort-th>
        </tr>
    </thead>
    <tbody>
        @foreach (var i in Model.Items)
        {
            <tr>
                <td>@i.IssueDate.ToString("dd-MMM-yyyy")</td>
                <td>@i.FarmerCode — @i.FarmerName</td>
                <td>@i.ItemType</td>
                <td>@i.FeedName</td>
                <td>@i.Quantity.ToString("0.00")</td>
                <td>₹@i.TotalCost.ToString("0.00")</td>
            </tr>
        }
        @if (!Model.Items.Any())
        {
            <tr><td colspan="6" class="text-center text-muted">No issues recorded yet.</td></tr>
        }
    </tbody>
</table>
<paged-pager list="Model"></paged-pager>
</div>
