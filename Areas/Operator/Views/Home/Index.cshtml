@{
    ViewData["Title"] = "Operator Dashboard";
}

<h2 class="mb-4">Operator Dashboard</h2>

<div class="row mb-4">
    <div class="col-md-8">
        <h5>Last 7 Days — Collection Trend</h5>
        <canvas id="trendChart" height="90"></canvas>
    </div>
</div>

<div class="row g-3">
    <div class="col-auto">
        <div class="card" style="width: 20rem;">
            <div class="card-body">
                <h5 class="card-title">Farmers</h5>
                <p class="card-text">Register and manage farmers in your society.</p>
                <a asp-controller="Farmer" asp-action="Index" class="btn btn-primary">Manage Farmers</a>
            </div>
        </div>
    </div>
    <div class="col-auto">
        <div class="card" style="width: 20rem;">
            <div class="card-body">
                <h5 class="card-title">Milk Rate Chart</h5>
                <p class="card-text">Set fat-based rates per litre for your society.</p>
                <a asp-controller="MilkRate" asp-action="Index" class="btn btn-primary">Manage Rates</a>
            </div>
        </div>
    </div>
    <div class="col-auto">
        <div class="card" style="width: 20rem;">
            <div class="card-body">
                <h5 class="card-title">Milk Collection</h5>
                <p class="card-text">Record daily morning/evening collections.</p>
                <a asp-controller="MilkCollection" asp-action="Index" class="btn btn-primary">Record Collection</a>
            </div>
        </div>
    </div>
    <div class="col-auto">
        <div class="card" style="width: 20rem;">
            <div class="card-body">
                <h5 class="card-title">Feed & Medicine</h5>
                <p class="card-text">Manage stock and issue items to farmers.</p>
                <a asp-controller="FeedInventory" asp-action="Index" class="btn btn-primary">Manage Inventory</a>
            </div>
        </div>
    </div>
    <div class="col-auto">
        <div class="card" style="width: 20rem;">
            <div class="card-body">
                <h5 class="card-title">Settlements</h5>
                <p class="card-text">Generate weekly farmer settlements.</p>
                <a asp-controller="Settlement" asp-action="Index" class="btn btn-primary">Manage Settlements</a>
            </div>
        </div>
    </div>
    <div class="col-auto">
        <div class="card" style="width: 20rem;">
            <div class="card-body">
                <h5 class="card-title">Dispatch</h5>
                <p class="card-text">Record daily dispatch and reconcile against collection.</p>
                <a asp-controller="Dispatch" asp-action="Index" class="btn btn-primary">Manage Dispatch</a>
            </div>
        </div>
    </div>
    <div class="col-auto">
        <div class="card" style="width: 20rem;">
            <div class="card-body">
                <h5 class="card-title">Reports</h5>
                <p class="card-text">Collection, settlement, stock, dispatch, and fat analysis reports.</p>
                <a asp-area="" asp-controller="Reports" asp-action="Index" class="btn btn-primary">View Reports</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <script>
        const trendLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.TrendLabels ?? new List<string>()));
        const trendValues = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.TrendValues ?? new List<decimal>()));

        new Chart(document.getElementById('trendChart'), {
            type: 'bar',
            data: { labels: trendLabels, datasets: [{ label: 'Litres Collected', data: trendValues, backgroundColor: '#0d6efd' }] },
            options: { plugins: { legend: { display: false } } }
        });
    </script>
}
