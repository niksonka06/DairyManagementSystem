@model OperatorDashboardViewModel
@{
    ViewData["Title"] = "Society Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-1">Society dashboard</h2>
        <p class="page-subtitle mb-0">Operations overview for @Model.OverviewDate.ToString("dd-MMM-yyyy")</p>
    </div>
    <partial name="_DashboardDateFilter" model="Model.OverviewDate" />
</div>

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card kpi-card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="text-muted small text-uppercase">Milk collected</div>
                <div class="fs-3 fw-semibold">@Model.TodayMilkLitres.ToString("0.00") L</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card kpi-card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="text-muted small text-uppercase">Payable</div>
                <div class="fs-3 fw-semibold">₹@Model.TodayPayable.ToString("0.00")</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card kpi-card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="text-muted small text-uppercase">Member farmers</div>
                <div class="fs-3 fw-semibold">@Model.ActiveFarmerCount</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card kpi-card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="text-muted small text-uppercase">To pay (generated)</div>
                <div class="fs-3 fw-semibold">₹@Model.PendingSettlementsAmount.ToString("0.00")</div>
                @if (Model.CarryForwardAmount < 0)
                {
                    <div class="small text-muted">Carry-forward ₹@Model.CarryForwardAmount.ToString("0.00") (next week)</div>
                }
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-lg-5">
        <div class="card h-100">
            <div class="card-header fw-semibold">Shifts</div>
            <div class="card-body">
                <div class="row g-3 text-center">
                    <div class="col-6">
                        <div class="border rounded p-3">
                            <div class="fs-4 fw-semibold">@Model.MorningEntries</div>
                            <div class="text-muted">Morning entries</div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="border rounded p-3">
                            <div class="fs-4 fw-semibold">@Model.EveningEntries</div>
                            <div class="text-muted">Evening entries</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-7">
        <div class="card h-100">
            <div class="card-header fw-semibold">Quick actions</div>
            <div class="card-body d-flex flex-wrap gap-2">
                <a asp-controller="MilkCollection" asp-action="Index" class="btn btn-outline-primary">Record collection <i class="bi bi-arrow-right ms-1"></i></a>
                <a asp-controller="Settlement" asp-action="Index" class="btn btn-outline-primary">Generate settlements <i class="bi bi-arrow-right ms-1"></i></a>
                <a asp-controller="FeedIssue" asp-action="Index" class="btn btn-outline-primary">Issue feed <i class="bi bi-arrow-right ms-1"></i></a>
                <a asp-controller="Dispatch" asp-action="Index" class="btn btn-outline-primary">Record dispatch <i class="bi bi-arrow-right ms-1"></i></a>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header fw-semibold">Last 7 days — collection trend</div>
    <div class="card-body">
        <div class="chart-frame">
            <canvas id="trendChart"></canvas>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <script>
        const trendLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TrendLabels));
        const trendValues = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TrendValues));

        new Chart(document.getElementById('trendChart'), {
            type: 'bar',
            data: {
                labels: trendLabels,
                datasets: [{
                    label: 'Litres Collected',
                    data: trendValues,
                    backgroundColor: '#227a5c',
                    borderRadius: 8
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: { y: { beginAtZero: true } }
            }
        });
    </script>
}
